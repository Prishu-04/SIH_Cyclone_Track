# Copy this file to .env and fill in your real key. Never commit .env itself.

# Required: get a FREE key (no credit card needed) at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional overrides
# Primary free model to try first. See https://openrouter.ai/models?max_price=0
# for the current live list of :free model IDs (the free lineup rotates often).
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Comma-separated models to try in order if the primary is rate-limited/removed.
# openrouter/free is OpenRouter's own auto-router that picks any working free model.
OPENROUTER_FALLBACK_MODELS=openai/gpt-oss-20b:free,openrouter/free
# Shown in your OpenRouter usage dashboard; any URL is fine for local dev.
OPENROUTER_SITE_URL=https://cyclonai.local

# Comma-separated list of allowed frontend origins, e.g. http://localhost:5500,https://yourdomain.com
# "*" is convenient for local development/demos, but a real deployment that
# handles real emergency/personal data should restrict this to your actual
# frontend origin(s).
CORS_ORIGINS=*

# Optional: where the emergency help-request submissions are stored (JSON-lines file
# relative to the backend directory). Defaults to data/help_requests.jsonl.
# HELP_REQUESTS_FILE=data/help_requests.jsonl

# Optional: where missing-person reports are stored (JSON-lines file, relative
# to the backend directory). Defaults to data/missing_persons.jsonl.
# RESPONSE_DATA_DIR=data

# Required to enable the responder-only inbox routes
# (GET /api/help-requests/inbox and GET /api/v1/missing-persons).
# Pick a long random value and share it only with authorised responders; send
# it as the X-Responder-Token header. Leave unset to keep these routes
# disabled (they return 503, not the data) — this is the default, safer state.
# RESPONDER_ACCESS_TOKEN=change-me-to-a-long-random-secret
